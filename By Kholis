-- AVATAR FUNCTION
local function GetAvatar(UserId)
    return "rbxthumb://type=AvatarHeadShot&id="..UserId.."&w=180&h=180"
end

-- CHECK FRIENDS
local function CheckFriends(Player)

    PlayerName.Text = Player.Name
    Avatar.Image = GetAvatar(Player.UserId)

    for _, v in ipairs(FriendScroll:GetChildren()) do
        if v:IsA("Frame") or v:IsA("TextLabel") then
            v:Destroy()
        end
    end

    local Success, FriendsAsync = pcall(function()
        return Players:GetFriendsAsync(Player.UserId)
    end)

    if not Success then
        return
    end

    local FriendIds = {}

    repeat

        local CurrentPage = FriendsAsync:GetCurrentPage()

        for _, Friend in ipairs(CurrentPage) do
            FriendIds[Friend.Id] = true
        end

        if FriendsAsync.IsFinished then
            break
        end

        FriendsAsync:AdvanceToNextPageAsync()

    until false

    local FriendsInServer = {}

    for _, Plr in ipairs(Players:GetPlayers()) do

        if Plr.UserId ~= Player.UserId and FriendIds[Plr.UserId] then
            table.insert(FriendsInServer, Plr)
        end
    end

    Info.Text = "Friends In Server : "..#FriendsInServer

    if #FriendsInServer == 0 then

        local Empty = Instance.new("TextLabel")
        Empty.Size = UDim2.new(1,0,0,35)
        Empty.BackgroundTransparency = 1
        Empty.Text = "No friends found."
        Empty.TextColor3 = Color3.fromRGB(255,255,255)
        Empty.TextSize = 12
        Empty.Font = Enum.Font.Gotham
        Empty.Parent = FriendScroll

    else

        for _, FriendPlayer in ipairs(FriendsInServer) do

            local Holder = Instance.new("Frame")
            Holder.Size = UDim2.new(1,-6,0,42)
            Holder.BackgroundColor3 = Color3.fromRGB(40,40,60)
            Holder.BorderSizePixel = 0
            Holder.Parent = FriendScroll

            Instance.new("UICorner", Holder).CornerRadius = UDim.new(0,7)

            local AvatarFriend = Instance.new("ImageLabel")
            AvatarFriend.Size = UDim2.new(0,30,0,30)
            AvatarFriend.Position = UDim2.new(0,6,0.5,-15)
            AvatarFriend.BackgroundTransparency = 1
            AvatarFriend.Image = GetAvatar(FriendPlayer.UserId)
            AvatarFriend.Parent = Holder

            Instance.new("UICorner", AvatarFriend).CornerRadius = UDim.new(1,0)

            local FriendName = Instance.new("TextLabel")
            FriendName.Size = UDim2.new(1,-44,0,18)
            FriendName.Position = UDim2.new(0,42,0,4)
            FriendName.BackgroundTransparency = 1
            FriendName.Text = FriendPlayer.Name
            FriendName.TextColor3 = Color3.fromRGB(255,255,255)
            FriendName.TextSize = 12
            FriendName.Font = Enum.Font.GothamBold
            FriendName.TextXAlignment = Enum.TextXAlignment.Left
            FriendName.Parent = Holder

            local DisplayName = Instance.new("TextLabel")
            DisplayName.Size = UDim2.new(1,-44,0,14)
            DisplayName.Position = UDim2.new(0,42,0,22)
            DisplayName.BackgroundTransparency = 1
            DisplayName.Text = "@"..FriendPlayer.DisplayName
            DisplayName.TextColor3 = Color3.fromRGB(180,180,220)
            DisplayName.TextSize = 10
            DisplayName.Font = Enum.Font.Gotham
            DisplayName.TextXAlignment = Enum.TextXAlignment.Left
            DisplayName.Parent = Holder
        end
    end

    task.wait()

    FriendScroll.CanvasSize = UDim2.new(
        0,
        0,
        0,
        FriendLayout.AbsoluteContentSize.Y + 5
    )
end

